// Esquema de base de datos - Plataforma MA Importaciones
// Postgres (Neon). El esquema se cambia con migraciones versionadas:
// `npx prisma migrate dev --name lo-que-cambiaste` (ver README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Un contenedor / arribo. Cada uno agrupa las líneas cargadas desde un Excel.
model Container {
  id         String    @id @default(cuid())
  name       String // Ej: "Contenedor 1 - Julio 2026"
  supplier   String? // Proveedor (opcional)
  eta        DateTime? // Fecha estimada de arribo (opcional)
  notes      String? // Notas (opcional)
  totalPrice Float? // Precio total del contenedor (fila "TOTAL" del Excel)
  freightCost Float? // Costo del flete del contenedor (USD)
  origin     String  @default("china") // "china" | "brasil"
  /// Etapa del embarque en el tablero: produccion | embarcado | transito |
  /// aduana | deposito. `receivedAt` manda: si tiene fecha, el estado efectivo
  /// es "deposito" (ver `estadoEfectivo` en lib/embarques.ts). Así los
  /// contenedores que ya existían no necesitan migración de datos.
  status     String  @default("produccion")
  receivedAt DateTime? // Fecha en que ingresó al depósito (null = en camino)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]
  docs       ContainerDoc[]

  @@index([receivedAt])
  @@index([status])
}

/// Documento adjunto de un embarque (factura, packing list, BL, DUA…).
/// El archivo vive en Vercel Blob; acá solo guardamos la URL y los metadatos.
model ContainerDoc {
  id          String    @id @default(cuid())
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  type        String // factura | packing | bl | dua | seguro | otro
  name        String // Nombre original del archivo
  url         String // URL pública de Vercel Blob
  size        Int? // Tamaño en bytes
  uploadedBy  String? // Usuario que lo subió
  createdAt   DateTime  @default(now())

  @@index([containerId])
}

/// Una línea del Excel (un producto dentro de un contenedor).
/// Un ítem del contenedor. Puede agrupar varias líneas del Excel (mismo código
/// base, o líneas que comparten una foto combinada). El detalle por talle/línea
/// queda en `detalle`.
model Product {
  id              String    @id @default(cuid())
  containerId     String
  container       Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  rowIndex        Int // Orden de aparición en el Excel
  photo           String? // URL de la foto en Vercel Blob (ver lib/photos.ts)
  /// true cuando la foto la puso una persona desde el panel (no salió del
  /// Excel). Una foto manual le gana a la de MercadoLibre en la tabla y en la
  /// planilla: si alguien se tomó el trabajo de corregirla, esa es la buena.
  fotoManual      Boolean   @default(false)
  codigo          String? // Código a mostrar (base cuando hay varios)
  precioChina     Float? // Precio unitario FOB (USD), representativo
  cantidadPorCaja Int? // Unidades por caja (QTY/CTN) de la primera línea
  unidades        Int? // Unidades totales que llegan (Quantity)
  montoTotal      Float? // Precio del lote (Amount)
  unidad          String? // Unidad: pc / Pair / SET…
  remark          String? // Observaciones combinadas
  cbmUnitario     Float?
  cbmTotal        Float? // CBM total del ítem (suma)
  detalle         Json? // Desglose por línea/talle: [{codigos, unidades, monto, cbmTotal, remark}]
  createdAt       DateTime  @default(now())

  @@index([containerId])
}

/// Un análisis de reposición: cruza las ventas de un período con el stock
/// disponible y sugiere cuánto pedir. Ventas y stock se guardan como JSON.
model Reposicion {
  id         String   @id @default(cuid())
  name       String // Ej: "Reposición mayo 2026"
  periodo    String? // Período detectado del Excel de ventas (ej. "mayo 2026")
  meses      Int      @default(4) // Meses de cobertura a pedir
  ventas     Json? // [{ codigo, titulo, unidades }]
  stock      Json? // [{ codigo, titulo, disponible }]
  ventasFile String? // Nombre del último archivo de ventas subido
  stockFile  String? // Nombre del último archivo de stock subido
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Costo unitario manual (override) de un SKU. La API MUNDO SHOP es de solo
/// lectura, así que el costo editado desde Órdenes Real-Time se guarda acá y
/// pisa al `standard_price` de Odoo para ese SKU en todas las órdenes.
model CostOverride {
  sku       String   @id // default_code / SKU de MercadoLibre
  cost      Float // Costo unitario en pesos
  note      String? // Nota opcional
  updatedBy String? // Usuario que editó por última vez
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Usuario de la plataforma con acceso por módulos.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  modules      String[] // ["inicio","embarques","admin"]
  lastLoginAt  DateTime? // Último acceso exitoso
  createdAt    DateTime @default(now())
}

/// Intentos fallidos de login, para frenar la fuerza bruta contra el panel.
///
/// Hay una fila por clave y se usan dos claves a la vez (ver `lib/loginThrottle.ts`):
/// `u:<usuario>|<ip>` frena a quien insiste con un usuario desde un lugar, e
/// `ip:<ip>` frena a quien prueba usuarios distintos desde el mismo lugar. La
/// fila se borra sola cuando el login sale bien.
///
/// Va en la base y no en memoria a propósito: en Vercel cada instancia tiene su
/// propia memoria, así que un contador en RAM se saltea solo con reintentar.
model LoginAttempt {
  key         String    @id
  fails       Int       @default(0)
  lastFailAt  DateTime
  lockedUntil DateTime?
}

/// Preferencias de perfil por usuario (ej. foto). Separado de User para que
/// también valga para el superadmin, que no tiene fila en User.
model Profile {
  username  String   @id // coincide con SessionData.user
  photoUrl  String? // URL de la foto de perfil (Vercel Blob)
  updatedAt DateTime @updatedAt
}

/// Configuración de un reporte de la sección Reportes. Una fila por reporte
/// (key = "ventas-aceleradas"). Guarda el número de WhatsApp destino y los
/// umbrales, editables desde la pantalla.
model ReportConfig {
  key        String   @id // identificador del reporte, ej. "ventas-aceleradas"
  enabled    Boolean  @default(true) // si el envío automático (cron) está activo
  whatsappTo String? // números destino en E.164 sin "+", separados por coma
  emailTo    String? // mails destino separados por coma (alertas de experiencia)
  params     Json? // umbrales del reporte (ventanaDias, baseDias, ratioMin, ...)
  updatedAt  DateTime @updatedAt
}

/// Una captura de la experiencia de compra sacada del PANEL DE VENDEDOR de ML.
///
/// Existe porque el dato no está en ninguna API: la documentación de MUNDO SHOP
/// lo dice en sus notas («Reclamos: No disponible por API de ML, permiso no
/// habilitado»). La captura se hace con el navegador contra el panel (ver el
/// README), se importa y queda guardada acá; el reporte se arma leyendo la última.
///
/// Se guardan TODAS las capturas, no solo la última, porque comparar dos
/// capturas es lo único que permite saber qué SKU empeoró: los reclamos de la
/// ventana de 180 días solo se leen como total, así que un salto entre capturas
/// es un problema nuevo.
model ExperienciaSnapshot {
  id            String   @id @default(cuid())
  capturadoEn   DateTime // cuándo se sacó del panel
  importadoEn   DateTime @default(now())
  importadoPor  String? // usuario que la subió
  publicaciones Int // publicaciones que trae la captura
  conDetalle    Int // cuántas traen el detalle de experiencia (las que están por debajo de 100)
  skus          Int // SKU que quedan listados en el reporte
  reclamos      Int // total de problemas de compradores informados
  payload       Json // las publicaciones normalizadas (CapturaPub[])

  @@index([capturadoEn])
}

/// LEGACY del reporte anterior de experiencia, que en realidad medía la CALIDAD
/// de la ficha (9 aspectos de `/ml-experiencia/:id` de MUNDO SHOP) y no los
/// problemas de los compradores. Ya no la escribe ni la lee nadie: el reporte
/// vive en `ExperienciaSnapshot`. Se puede borrar cuando se quiera — queda por
/// ahora para no tirar datos de producción en la misma migración que rehace el
/// módulo.
model ExperienciaScore {
  itemId    String   @id // id de la publicación (MLU...)
  sku       String? // SKU de la publicación, si tiene
  codigo    String? // código base / SKU unificado del grupo
  titulo    String
  score     Int // puntaje actual (0..100)
  nivel     String // EXCELENTE | BUENA | REGULAR | MALA
  checkedAt DateTime // cuándo se leyó este puntaje

  // ---- marca de caída (lo que se ve en el panel y se avisa por mail) ----
  bajoDe       Int? // puntaje que tenía antes de caer
  bajoDelta    Int? // puntos que bajó
  bajoEn       DateTime? // cuándo se detectó la caída
  bajoCruzo100 Boolean   @default(false) // venía en 100 y dejó de estar perfecta
  bajoProblema String? // problema principal en el momento de la caída
  avisadoEn    DateTime? // cuándo salió el mail
  avisoStatus  String? // "sent" | "skipped:<motivo>" | "error:<detalle>"
  vistoEn      DateTime? // cuándo se marcó como vista en el panel
  vistoPor     String? // quién la marcó

  @@index([codigo])
  @@index([bajoEn])
}

/// Foto elegida a mano para un código, para reusarla en los embarques que
/// vengan. Cuando alguien corrige la foto de un ítem en un embarque se guarda
/// acá con su código base ("48108-BEI-39" -> "48108"), y todo ítem futuro con
/// ese código nace con esa foto en vez de la que traiga el Excel.
model CodigoFoto {
  codigo    String   @id // código base normalizado (mayúsculas)
  url       String // foto en Vercel Blob
  updatedBy String? // usuario que la fijó por última vez
  updatedAt DateTime @updatedAt
}

/// Origen de un producto por código padre (base, sin variante). Se usa para
/// decidir cuántos meses de cobertura pedir (China = 4, Brasil = 1). Solo se
/// guardan los de Brasil; lo que no está listado se asume de China.
model ProductOrigin {
  codigo    String   @id // código padre / base, ej. "16000"
  origin    String   @default("brasil") // por ahora siempre "brasil"
  updatedAt DateTime @updatedAt
}

/// Ventas mensuales históricas por código (importadas del export del negocio:
/// Zureo 2023-08→2025-08 + Odoo 2025-08→2026-05). Se usa para la comparación
/// interanual del reporte "Sin rotación" en los meses que MUNDO SHOP todavía no
/// cubre. `code` es el código tal cual venía (puede tener variante).
model VentaHistorica {
  code String // código del producto (puede incluir variante)
  mes  String // "YYYY-MM"
  qty  Int // unidades vendidas ese mes

  @@id([code, mes])
  @@index([mes])
}

/// Una corrida de un reporte (manual o automática). Guarda el snapshot de los
/// SKUs marcados para poder mostrarlo en la sección y saber qué se envió.
model ReportRun {
  id             String   @id @default(cuid())
  reportKey      String // "ventas-aceleradas" | "experiencia"
  trigger        String   @default("manual") // "manual" | "cron"
  items          Json // SKUs en riesgo detectados (snapshot)
  summary        Json // { total, unidadesRiesgo, ... }
  whatsappStatus String? // "sent" | "skipped:<motivo>" | "error:<detalle>"
  whatsappTo     String? // a qué número(s) se envió
  emailStatus    String? // ídem para el mail (reporte de experiencia)
  emailTo        String? // a qué mail(s) se envió
  createdAt      DateTime @default(now())

  @@index([reportKey, createdAt])
}
