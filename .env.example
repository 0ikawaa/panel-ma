# === Copiá este archivo como .env y completá los valores ===

# Base de datos.
# LOCAL (SQLite):
DATABASE_URL="file:./dev.db"
# NUBE (Postgres) - ejemplo con Neon/Supabase:
# DATABASE_URL="postgresql://usuario:password@host:5432/basedatos?sslmode=require"

# Credenciales de acceso a la plataforma
ADMIN_USER="admin"
ADMIN_PASSWORD="admin"

# Secreto para firmar sesiones. Generá uno largo y aleatorio para producción.
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# === Reportes (sección Reportes) ===
# Secreto que valida el cron diario (Vercel manda "Authorization: Bearer $CRON_SECRET").
# Sin este valor, el endpoint /api/cron/reportes rechaza todo.
CRON_SECRET=""
# Número(s) de WhatsApp destino por defecto (E.164 sin "+", separados por coma).
# También se puede editar desde la pantalla del reporte.
REPORT_WHATSAPP_TO=""

# === Agendas (asesorías reservadas desde la web) ===
# Mismos valores que usa el sitio maimportaciones.com.uy: el panel lee los
# eventos del mismo Google Calendar. Se obtienen con `npm run agenda:auth`
# en el repo de la web (ver ahí SETUP-AGENDA.md).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# 'primary' = calendario principal de la cuenta autorizada.
GOOGLE_CALENDAR_ID="primary"

# === WhatsApp (Meta Cloud API) ===
# Token permanente e ID del número emisor de la app de WhatsApp Business.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Plantilla aprobada para avisos proactivos (fuera de la ventana de 24h, ej. el cron).
# El resumen del reporte se pasa como parámetro {{1}} del cuerpo. Sin plantilla,
# solo funciona el envío de texto libre (útil para pruebas dentro de la ventana de 24h).
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="es_AR"
# WHATSAPP_API_VERSION="v21.0"
